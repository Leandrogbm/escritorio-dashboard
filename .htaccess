# Cache do navegador pro build estático (Hostinger/Apache).
#
# index.html NUNCA pode ficar em cache — é ele que aponta pros arquivos com hash certo do
# build atual (dist/assets/*-<hash>.js). Se o navegador guardar um index.html velho, ele
# carrega apontando pra um build antigo mesmo depois de um deploy novo -- causa real de mais
# de um "isso já foi corrigido, por que ainda dá esse erro" nesse projeto (build antigo
# rodando escondido atrás de um cache que ninguém via).
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Assets com hash no nome (Vite) podem ficar em cache por muito tempo -- o próprio hash já
# muda o nome do arquivo quando o conteúdo muda, então "imutável" aqui é seguro de verdade.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
